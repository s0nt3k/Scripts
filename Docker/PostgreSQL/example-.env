# PostgreSQL Docker Container - Example Environment File
# Copy this file to .env before starting the container:
#   cp example-.env .env
#
# IMPORTANT:
# Replace the example credentials below before deployment.
# Protect the completed .env file with:
#   chmod 600 .env

# -----------------------------------------------------------------------------
# PostgreSQL Docker Image
# Used by: image: postgres:${POSTGRES_VERSION:-17}
# -----------------------------------------------------------------------------
POSTGRES_VERSION=17

# -----------------------------------------------------------------------------
# Container Settings
# -----------------------------------------------------------------------------
POSTGRES_CONTAINER_NAME=postgresql
POSTGRES_HOSTNAME=postgresql

# -----------------------------------------------------------------------------
# PostgreSQL Initial Database Credentials
# Change these values before deployment.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=postgres

# -----------------------------------------------------------------------------
# Time Zone
# -----------------------------------------------------------------------------
TZ=America/Los_Angeles

# -----------------------------------------------------------------------------
# Shared Docker Network
# Other containers can join this network and connect to PostgreSQL using
# the hostname: postgresql
# -----------------------------------------------------------------------------
POSTGRES_NETWORK_NAME=database

# -----------------------------------------------------------------------------
# Persistent Docker Volume
# -----------------------------------------------------------------------------
POSTGRES_VOLUME_NAME=postgres_data
