# NodeBB Docker - Example Environment File
# Copy to .env:
#   cp example-.env .env
#
# IMPORTANT:
# Do not commit the real .env file to Git.

# Host port used to reach NodeBB during setup.
NODEBB_HOST_PORT=4567

# Public URL information used during the NodeBB setup wizard.
NODEBB_PROTOCOL=https
NODEBB_DOMAIN=forum.example.com

# PostgreSQL connection values.
# These are used when completing NodeBB's setup wizard.
NODEBB_DB_HOST=postgresql
NODEBB_DB_PORT=5432
NODEBB_DB_NAME=nodebb
NODEBB_DB_USER=nodebb
NODEBB_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
NODEBB_DB_SSL=false

# Shared PostgreSQL Docker network.
POSTGRES_NETWORK_NAME=database

# Persistent NodeBB volume.
NODEBB_VOLUME_NAME=nodebb_data

# Time zone.
TZ=America/Los_Angeles
