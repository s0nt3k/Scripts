# ============================================================
# Zammad Docker Environment Variables
# Copy this file to .env before deployment:
#   cp example-.env .env
# ============================================================

# Zammad
IMAGE_REPO=ghcr.io/zammad/zammad
VERSION=7.1.3-0006
RESTART=unless-stopped
TZ=America/Los_Angeles

# Web Interface
NGINX_PORT=8080
NGINX_EXPOSE_PORT=8080
NGINX_CLIENT_MAX_BODY_SIZE=50M

# Set this to the DNS name that will be used for Zammad.
# Example: support.example.com
ZAMMAD_FQDN=localhost
ZAMMAD_HTTP_TYPE=http

# PostgreSQL
POSTGRES_VERSION=17.11-alpine
POSTGRES_DB=zammad_production
POSTGRES_USER=zammad

# IMPORTANT:
# Replace this value before starting Zammad.
# Generate a strong 64-character password with:
#   openssl rand -base64 48
POSTGRES_PASS=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

POSTGRES_HOST=zammad-postgresql
POSTGRES_PORT=5432
POSTGRESQL_OPTIONS=?pool=50

# Redis
REDIS_VERSION=8.10.1-alpine
REDIS_URL=redis://zammad-redis:6379

# Memcached
MEMCACHE_VERSION=1.6.45-alpine
MEMCACHE_SERVERS=zammad-memcached:11211

# Elasticsearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_VERSION=9.5.2
ELASTICSEARCH_SCHEMA=http
ELASTICSEARCH_HOST=zammad-elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NAMESPACE=zammad
ELASTICSEARCH_REINDEX=true

# Elasticsearch JVM memory.
# Zammad requires a host with at least 4 GB RAM.
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# Zammad Backup
BACKUP_DIR=/var/tmp/zammad
BACKUP_TIME=03:00
BACKUP_ON_START=false
HOLD_DAYS=10

# Optional reverse-proxy configuration.
# Leave blank unless you know the proxy addresses/subnets.
RAILS_TRUSTED_PROXIES=
